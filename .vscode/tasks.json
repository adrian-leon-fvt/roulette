{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run roulette",
            "type": "process",
            "command": "uv",
            "args": ["run", "roulette.py"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "Test roulette",
            "type": "process",
            "command": "uv",
            "args": ["run", "python", "-m", "unittest", "-v"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": "test",
            "problemMatcher": []
        }
    ]
}
